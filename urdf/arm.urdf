<?xml version ="1.0"?>
<robot name="my_arm">
    <joint name="my_joint" type="revolute">
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="my_new_link"/>
        <axis xyz = "0 1 0"/>
        <limit effort="30" velocity="1.0" lower="-2.2" upper="0.7"/>
    </joint>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.2 0.2 0.05"/>
            </geometry>
        </visual>
    </link>
    <link name="my_new_link">
        <visual>
            <origin xyz="0 0 0.25"/>
            <geometry>
                <cylinder radius="0.05" length="0.5"/>
            </geometry>
        </visual>
    </link>
</robot> 
